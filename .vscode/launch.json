{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ENGINEX: Run Launch.exe (Turnkey Launcher)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Launch.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "ENGINEX: Run Backend Server (127.0.0.1:8080)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/backend_server.exe",
      "args": ["--port", "8080", "--web-root", "${workspaceFolder}/frontend/out"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
    },
    {
      "name": "ENGINEX: Run Unit Tests (test_job_manager)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/tests/test_job_manager.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
    }
  ]
}

